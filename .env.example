# Копируйте этот файл в .env и заполните значения.
# Запуск: скопировать .env.example -> .env

# Порт веб-приложения
PORT=3000

# Секрет для сессий (замените на случайную строку)
SESSION_SECRET=change-me-to-random-string

# Telegram-бот подтверждения регистраций (опционально)
# Токен получите у @BotFather, ADMIN_CHAT_ID — у @userinfobot
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=