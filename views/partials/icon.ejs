<%
  // Иконки приложения: 24x24, обводка currentColor, декоративные (aria-hidden).
  // Вызов: include('partials/icon', { name: 'print' }) внутри тега вывода.
  //
  // Разметка выводится литерально через if/else, а не хранится в JS-строках:
  // лексер EJS не отслеживает вложенные кавычки внутри тега — состояние
  // внутри-строки не сбрасывается, закрывающий тег не распознаётся и шаблон
  // падает с ошибкой про отсутствующий закрывающий тег. Поэтому ни в этом
  // комментарии, ни в коде ниже нет двойных кавычек и последовательностей
  // открывающего или закрывающего тега.
  const iconName = typeof name !== 'undefined' ? name : '';
%>
<svg class="icon"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.8"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false"
     xmlns="http://www.w3.org/2000/svg"><% if (iconName === 'calculator') { %>
  <rect x="4" y="2" width="16" height="20" rx="2"/>
  <path d="M8 6h8"/>
  <path d="M8 11h.01"/>
  <path d="M12 11h.01"/>
  <path d="M16 11h.01"/>
  <path d="M8 15h.01"/>
  <path d="M12 15h.01"/>
  <path d="M16 15h.01"/>
  <path d="M8 19h4"/><% } else if (iconName === 'sliders') { %>
  <path d="M4 21v-6"/>
  <path d="M4 11V3"/>
  <path d="M12 21v-9"/>
  <path d="M12 8V3"/>
  <path d="M20 21v-5"/>
  <path d="M20 12V3"/>
  <path d="M1 15h6"/>
  <path d="M9 8h6"/>
  <path d="M17 16h6"/><% } else if (iconName === 'file-text') { %>
  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/>
  <path d="M14 2v5h6"/>
  <path d="M8 13h8"/>
  <path d="M8 17h8"/>
  <path d="M8 9h2"/><% } else if (iconName === 'users') { %>
  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
  <circle cx="9" cy="7" r="4"/>
  <path d="M22 21v-2a4 4 0 0 0-3-3.9"/>
  <path d="M16 3.1a4 4 0 0 1 0 7.8"/><% } else if (iconName === 'user') { %>
  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
  <circle cx="12" cy="7" r="4"/><% } else if (iconName === 'database') { %>
  <ellipse cx="12" cy="5" rx="9" ry="3"/>
  <path d="M3 5v14a9 3 0 0 0 18 0V5"/>
  <path d="M3 12a9 3 0 0 0 18 0"/><% } else if (iconName === 'upload') { %>
  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
  <path d="m17 8-5-5-5 5"/>
  <path d="M12 3v12"/><% } else if (iconName === 'download') { %>
  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
  <path d="m7 10 5 5 5-5"/>
  <path d="M12 15V3"/><% } else if (iconName === 'save') { %>
  <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
  <path d="M17 21v-8H7v8"/>
  <path d="M7 3v5h8"/><% } else if (iconName === 'print') { %>
  <path d="M6 9V3h12v6"/>
  <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
  <path d="M6 14h12v7H6z"/><% } else if (iconName === 'factory') { %>
  <path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/>
  <path d="M17 18h1"/>
  <path d="M12 18h1"/>
  <path d="M7 18h1"/><% } else if (iconName === 'log-out') { %>
  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
  <path d="m16 17 5-5-5-5"/>
  <path d="M21 12H9"/><% } else if (iconName === 'send') { %>
  <path d="m22 2-7 20-4-9-9-4z"/>
  <path d="M22 2 11 13"/><% } else if (iconName === 'arrow-left') { %>
  <path d="m12 19-7-7 7-7"/>
  <path d="M19 12H5"/><% } else if (iconName === 'external-link') { %>
  <path d="M15 3h6v6"/>
  <path d="M10 14 21 3"/>
  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><% } else if (iconName === 'inbox') { %>
  <path d="M22 12h-6l-2 3h-4l-2-3H2"/>
  <path d="M5.5 5.5 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.5A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.7 1.5z"/><% } else if (iconName === 'snowflake') { %>
  <path d="M12 2v20"/>
  <path d="M3.3 7 20.7 17"/>
  <path d="M20.7 7 3.3 17"/><% } else if (iconName === 'check') { %>
  <path d="M20 6 9 17l-5-5"/><% } else if (iconName === 'check-circle') { %>
  <path d="M22 11.1V12a10 10 0 1 1-5.9-9.1"/>
  <path d="m9 11 3 3L22 4"/><% } else if (iconName === 'x') { %>
  <path d="M18 6 6 18"/>
  <path d="m6 6 12 12"/><% } else if (iconName === 'x-circle') { %>
  <circle cx="12" cy="12" r="10"/>
  <path d="m15 9-6 6"/>
  <path d="m9 9 6 6"/><% } else if (iconName === 'alert') { %>
  <path d="m21.7 18-8-14a2 2 0 0 0-3.4 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3z"/>
  <path d="M12 9v4"/>
  <path d="M12 17h.01"/><% } else if (iconName === 'info') { %>
  <circle cx="12" cy="12" r="10"/>
  <path d="M12 16v-4"/>
  <path d="M12 8h.01"/><% } else if (iconName === 'star') { %>
  <path d="m12 3 2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8L6.6 19.6l1-6L3.3 9.4l6-.9L12 3z"/><% } %>
</svg>
