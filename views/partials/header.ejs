<%
  // Активный раздел для навигации: res.locals.currentPath выставляется
  // в server.js один раз для всех страниц.
  const navPath = typeof currentPath !== 'undefined' && currentPath ? currentPath : '';
  const isActive = (href) => navPath === href || navPath.startsWith(href + '/');
  const pageTitle = typeof title !== 'undefined' && title ? title : 'Подбор холодильного агрегата';
%>
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#173F6D">
  <meta name="description" content="Подбор и расчёт холодильных агрегатов: компрессоры, трубопроводы, виброгасители, спецификация и коммерческое предложение.">
  <title><%= pageTitle %> · MAIR</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#content">Перейти к содержимому</a>

  <header class="appbar">
    <div class="appbar__inner">
      <a class="brand" href="/calc" title="Перейти к подбору оборудования">
        <span class="brand__mark"><%- include('brand-mark') %></span>
        <span class="brand__text">
          <strong>MAIR</strong>
          <span>Подбор холодильного агрегата</span>
        </span>
      </a>

      <% if (user) { %>
        <nav class="appbar__nav" aria-label="Основная навигация">
          <a class="navlink" href="/calc"<% if (isActive('/calc')) { %> aria-current="page"<% } %>>
            <%- include('icon', { name: 'calculator' }) %>Подбор
          </a>
          <a class="navlink" href="/quotes"<% if (isActive('/quotes')) { %> aria-current="page"<% } %>>
            <%- include('icon', { name: 'file-text' }) %>Мои КП
          </a>
          <% if (user.role === 'admin') { %>
            <a class="navlink" href="/admin/users"<% if (isActive('/admin/users')) { %> aria-current="page"<% } %>>
              <%- include('icon', { name: 'users' }) %>Пользователи
            </a>
            <a class="navlink" href="/admin/import"<% if (isActive('/admin/import')) { %> aria-current="page"<% } %>>
              <%- include('icon', { name: 'upload' }) %>Импорт Excel
            </a>
            <a class="navlink" href="/admin/catalog"<% if (isActive('/admin/catalog')) { %> aria-current="page"<% } %>>
              <%- include('icon', { name: 'database' }) %>Каталог
            </a>
          <% } %>
        </nav>

        <div class="appbar__user">
          <span class="userchip">
            <span class="userchip__name"><%= user.name %></span>
            <span class="userchip__role"><%= user.role === 'admin' ? 'Администратор' : 'Инженер' %></span>
          </span>
          <form method="POST" action="/logout" class="inline-form">
            <button type="submit" class="navlink" title="Выйти из системы">
              <%- include('icon', { name: 'log-out' }) %>Выход
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </header>

  <main class="shell" id="content">
