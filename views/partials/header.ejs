<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Rack Calculation' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="topnav">
    <div class="brand">❄ Rack Calculation</div>
    <% if (user) { %>
      <div class="nav-links">
        <a href="/calc">Расчет</a>
        <a href="/quotes">Мои КП</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin/users">Пользователи</a>
          <a href="/admin/import">Импорт Excel</a>
          <a href="/admin/catalog">Каталог</a>
        <% } %>
        <span class="user-info"><%= user.name %><% if (user.discount_percent > 0) { %> (скидка <%= user.discount_percent %>%)<% } %></span>
        <form method="POST" action="/logout" class="inline-form"><button type="submit" class="btn-link">Выход</button></form>
      </div>
    <% } %>
  </nav>
  <main class="container">