<%
  // Виброгасители: индивидуальный подбор на каждый компрессор, раздельно для
  // линии всасывания и линии нагнетания. Партиал отдаёт готовый блок вместе
  // с обёрткой .table-wrap, поэтому вызывающая страница не оборачивает его.
  // Порядок строк: нагнетание выше всасывания
  const vibrationLines = [
    { key: 'discharge', label: 'Нагнетание' },
    { key: 'suction', label: 'Всасывание' }
  ];
  const showVibrationPrices = typeof isAdmin !== 'undefined' && isAdmin;
  const BASIS_LABELS = { port: 'по патрубку КМ', speed: 'по скорости', none: 'нет данных' };
  const basisLabel = (b) => BASIS_LABELS[b] || 'нет данных';
%>
<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Линия</th>
        <th>Компрессор</th>
        <th class="num">Кол-во КМ</th>
        <th class="num">Патрубок, "</th>
        <th class="num">Расход, кг/ч</th>
        <th>Виброгаситель</th>
        <th class="num">Ø, "</th>
        <th class="num">Скорость, м/с</th>
        <th>Подбор</th>
        <% if (showVibrationPrices) { %><th class="num">Цена, EUR</th><% } %>
      </tr>
    </thead>
    <tbody>
      <% vibrationLines.forEach(({ key, label }) => {
           const plan = vibration[key];
           (plan ? plan.lines : []).forEach(row => { %>
        <tr>
          <td><%= label %></td>
          <td><%= row.manufacturer %> <%= row.model %></td>
          <td class="num"><%= row.qty %></td>
          <td class="num"><%= row.portSizeIn != null ? inch(row.portSizeIn) : '—' %></td>
          <td class="num"><%= row.massFlowKgh %></td>
          <td class="cell-code"><%= row.article %></td>
          <td class="num num--strong"><%= inch(row.sizeIn) %></td>
          <td class="num"><%= row.velocity != null ? row.velocity : '—' %></td>
          <td class="muted"><%= basisLabel(row.basis) %></td>
          <% if (showVibrationPrices) { %><td class="num"><%= row.price_eur %></td><% } %>
        </tr>
      <% }); }); %>
    </tbody>
  </table>
  <p class="table-foot">
    Всего: нагнетание — <b class="num"><%= vibration.totalDischargeQty %></b> шт.,
    всасывание — <b class="num"><%= vibration.totalSuctionQty %></b> шт.
    Размер виброгасителя принят по диаметру патрубка компрессора, а при отсутствии
    этих данных — по скорости хладагента в рекомендованном диапазоне для
    индивидуальной производительности компрессора.
  </p>
</div>
