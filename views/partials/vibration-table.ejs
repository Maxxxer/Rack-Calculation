<%
  // Таблица виброгасителей: индивидуальный подбор на каждый компрессор,
  // раздельно для линии всасывания и линии нагнетания.
  const vibrationLines = [
    { key: 'suction', label: 'Всасывание' },
    { key: 'discharge', label: 'Нагнетание' }
  ];
  const showVibrationPrices = typeof isAdmin !== 'undefined' && isAdmin;
  const basisLabel = (b) => b === 'port' ? 'по патрубку КМ'
                       : b === 'speed' ? 'по скорости'
                       : 'нет данных';
%>
<table class="table">
  <tr>
    <th>Линия</th><th>Компрессор</th><th>Кол-во КМ</th>
    <th>Патрубок, "</th><th>Расход, кг/ч</th><th>Виброгаситель</th>
    <th>Ø, "</th><th>Скорость, м/с</th><th>Подбор</th>
    <% if (showVibrationPrices) { %><th>Цена, EUR</th><% } %>
  </tr>
  <% vibrationLines.forEach(({ key, label }) => {
       const plan = vibration[key];
       (plan ? plan.lines : []).forEach(row => { %>
    <tr>
      <td><%= label %></td>
      <td><%= row.manufacturer %> <%= row.model %></td>
      <td><%= row.qty %></td>
      <td><%= row.portSizeIn != null ? row.portSizeIn : '—' %></td>
      <td><%= row.massFlowKgh %></td>
      <td><%= row.article %></td>
      <td><b><%= row.sizeIn %></b></td>
      <td><%= row.velocity != null ? row.velocity : '—' %></td>
      <td><%= basisLabel(row.basis) %></td>
      <% if (showVibrationPrices) { %><td><%= row.price_eur %></td><% } %>
    </tr>
  <% }); }); %>
</table>
<p class="hint">
  Всего: всасывание — <b><%= vibration.totalSuctionQty %></b> шт.,
  нагнетание — <b><%= vibration.totalDischargeQty %></b> шт.
  Размер виброгасителя принят по диаметру патрубка компрессора, а при отсутствии
  этих данных — по скорости хладагента в рекомендованном диапазоне для
  индивидуальной производительности компрессора.
</p>
