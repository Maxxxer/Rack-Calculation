<%
  // Автономный печатный документ: подключает только /css/print-doc.css.
  // Светлая тема задаётся этим файлом стилей независимо от системных настроек,
  // поэтому документ всегда одинаков при отправке заказчику.
  const isAdmin = user && user.role === 'admin';
  const t = result.totals;
  const s = result.selection.totals;
  const quoteUrl = '/quotes/' + encodeURIComponent(q.number);
  const pipeLines = [
    { label: 'Всасывание', key: 'suction' },
    { label: 'Нагнетание', key: 'discharge' },
    { label: 'Жидкость', key: 'liquid' }
  ];
%>
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Коммерческое предложение <%= q.number %> · MAIR</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/print-doc.css">
</head>
<body>
  <div class="doc-toolbar">
    <button type="button" class="doc-btn doc-btn--primary" onclick="window.print()">
      <%- include('partials/icon', { name: 'print' }) %>Печать / PDF
    </button>
    <span class="doc-toolbar__spacer"></span>
    <span class="doc-toolbar__hint">Формат A4, книжная ориентация</span>
    <a class="doc-btn doc-btn--ghost" href="<%= quoteUrl %>">
      <%- include('partials/icon', { name: 'arrow-left' }) %>К предложению
    </a>
  </div>

  <article class="doc-page">
    <header class="doc-head">
      <div class="doc-brand">
        <%- include('partials/brand-mark', { label: 'MAIR' }) %>
        <span class="doc-brand__text">
          <span class="doc-brand__name">MAIR</span>
          <span class="doc-brand__desc">Подбор холодильного агрегата</span>
        </span>
      </div>
      <div class="doc-head__id">
        <h1>Коммерческое предложение</h1>
        <p class="doc-head__number">№ <%= q.number %></p>
        <p class="doc-head__date">от <%= q.created_at %></p>
      </div>
    </header>

    <dl class="doc-meta">
      <div>
        <dt>Заказчик</dt>
        <dd><%= q.user_name %></dd>
      </div>
      <% if (q.company) { %>
        <div>
          <dt>Компания</dt>
          <dd><%= q.company %></dd>
        </div>
      <% } %>
      <% if (q.email) { %>
        <div>
          <dt>Контакт</dt>
          <dd><%= q.email %></dd>
        </div>
      <% } %>
    </dl>

    <section class="doc-section">
      <div class="doc-section__head">
        <span class="doc-section__num">01</span>
        <span class="doc-section__title">Технические характеристики агрегата</span>
      </div>
      <div class="doc-cols">
        <table class="doc-kv">
          <tbody>
            <tr><td>Хладагент</td><td><%= result.input.refrigerant %></td></tr>
            <tr><td>Температура кипения</td><td><%= result.input.tEvap %> °C</td></tr>
            <tr><td>Температура конденсации</td><td><%= result.input.tCond %> °C</td></tr>
            <tr><td>Перегрев / переохлаждение</td><td><%= result.input.dTsh %> / <%= result.input.dTsc %> К</td></tr>
          </tbody>
        </table>
        <table class="doc-kv">
          <tbody>
            <tr><td>Холодопроизводительность</td><td><%= s.q_kw %> кВт</td></tr>
            <tr><td>Потребляемая мощность</td><td><%= s.power_kw %> кВт</td></tr>
            <tr><td>Теплопроизводительность</td><td><%= s.heat_kw %> кВт</td></tr>
            <tr><td>COP</td><td><%= s.cop %></td></tr>
            <tr><td>Массовый расход</td><td><%= s.mass_flow_kgh %> кг/ч</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="doc-section">
      <div class="doc-section__head">
        <span class="doc-section__num">02</span>
        <span class="doc-section__title">Компрессоры</span>
      </div>
      <table class="doc-table">
        <thead>
          <tr>
            <th>Производитель</th>
            <th>Модель</th>
            <th>Тип</th>
            <th class="num">Кол-во</th>
            <th class="num">Q, кВт</th>
            <th class="num">N, кВт</th>
            <th class="num">I, А</th>
          </tr>
        </thead>
        <tbody>
          <% result.selection.items.forEach(c => { %>
            <tr>
              <td><%= c.manufacturer %></td>
              <td class="code"><%= c.model %></td>
              <td><%= c.type === 'scroll' ? 'Спиральный' : c.type === 'screw' ? 'Винтовой' : 'Поршневой' %></td>
              <td class="num"><%= c.qty %></td>
              <td class="num"><%= c.q_kw %></td>
              <td class="num"><%= c.power_kw %></td>
              <td class="num"><%= c.current_a %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <section class="doc-section">
      <div class="doc-section__head">
        <span class="doc-section__num">03</span>
        <span class="doc-section__title">Трубопроводы</span>
      </div>
      <table class="doc-table">
        <thead>
          <tr>
            <th>Линия</th>
            <th class="num">Расход, кг/ч</th>
            <th class="num">Ø, дюймы</th>
            <th>Труба, мм</th>
            <th class="num">Скорость, м/с</th>
          </tr>
        </thead>
        <tbody>
          <% pipeLines.forEach(line => {
               const p = result.piping.common[line.key];
               const r = p.recommended; %>
            <tr>
              <td><%= line.label %></td>
              <td class="num"><%= p.massFlowKgh %></td>
              <td class="num strong"><%= r.size_in %></td>
              <td>Ø<%= r.od_mm %>×<%= r.wall_mm %></td>
              <td class="num"><%= r.v %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
<section class="doc-section">
      <div class="doc-section__head">
        <span class="doc-section__num">04</span>
        <span class="doc-section__title">Спецификация оборудования</span>
      </div>
      <table class="doc-table">
        <thead>
          <tr>
            <th class="num">№</th>
            <th>Артикул</th>
            <th>Наименование</th>
            <th class="num">Кол-во</th>
            <% if (isAdmin) { %>
              <th class="num">Цена, EUR</th>
              <th class="num">Сумма, EUR</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% result.bom.forEach((it, i) => { %>
            <tr>
              <td class="num"><%= i + 1 %></td>
              <td class="code"><%= it.article %></td>
              <td><%= it.name %></td>
              <td class="num"><%= it.qty %></td>
              <% if (isAdmin) { %>
                <td class="num"><%= it.unit_price_eur %></td>
                <td class="num"><%= it.total_price_eur %></td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <% if (isAdmin) { %>
        <table class="doc-totals">
          <tbody>
            <tr><td>Материалы</td><td><%= t.materials_eur %> EUR</td></tr>
            <tr><td>Мелочь (<%= t.petty_pct %>%)</td><td><%= t.petty_eur %> EUR</td></tr>
            <tr><td>Работы (<%= t.labor_pct %>%)</td><td><%= t.labor_eur %> EUR</td></tr>
            <tr><td>Профит (<%= t.profit_pct %>%)</td><td><%= t.profit_eur %> EUR</td></tr>
            <tr class="total"><td>Итого без НДС</td><td><%= t.subtotal_eur %> EUR</td></tr>
            <tr><td>Скидка клиента <%= t.discount_percent %>%</td><td>−<%= t.discount_amount_eur %> EUR</td></tr>
            <tr class="grand"><td>ВСЕГО</td><td><%= t.total_eur %> EUR</td></tr>
          </tbody>
        </table>
      <% } else { %>
        <table class="doc-totals">
          <tbody>
            <tr class="grand"><td>Цена агрегата (без НДС)</td><td><%= t.total_eur %> EUR</td></tr>
          </tbody>
        </table>
      <% } %>
    </section>

    <div class="doc-note">
      Цены указаны в EUR без НДС. Действительность предложения — 30 календарных дней с даты оформления.
    </div>
    <div class="doc-note">
      Технические характеристики соответствуют заявленному режиму работы. Производитель вправе вносить
      конструктивные изменения без ухудшения характеристик.
    </div>

    <div class="doc-sign">
      <span class="doc-sign__line">Поставщик: MAIR</span>
      <span class="doc-sign__line">Заказчик</span>
    </div>
  </article>
</body>
</html>
