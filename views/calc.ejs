<%- include('partials/header', { title: 'Подбор холодильного агрегата' }) %>

<%
  // Сохранение выбранных значений формы после расчёта.
  const isAdmin = user.role === 'admin';
  const f = form || {};
  const auto = f.auto || {};
  const manual = f.manual || {};
  const selMode = f.mode === 'manual' ? 'manual' : 'auto';
  const selAutoType = auto.type || f.autoType || 'any';
  const selAutoMfr = String(auto.manufacturerId || f.autoManufacturer || 'any');
  const selAutoMaxQty = String(auto.maxQty || f.autoMaxQty || 3);
  const selManualType = manual.type || f.manualType || 'any';
  const selManualMfr = String(manual.manufacturerId || f.manualManufacturer || 'any');
  const selCompQty = manual.qty || f.compressorQty || 1;
  const selOpts = Array.isArray(f.selectedOptions) ? f.selectedOptions
                : (f.options ? (Array.isArray(f.options) ? f.options : [f.options]) : []);

  // Окно «Опции» — только выбираемые позиции. Обязательные выведены
  // отдельным окном «Стандартная комплектация» справа.
  const selectableOptions = options.filter(o => !o.mandatory);
  const standardOptions = options.filter(o => o.mandatory);

  // Артикулы стандартных позиций известны только после расчёта.
  const standardArticles = new Map();
  if (result) {
    result.bom.forEach(i => {
      if (!standardArticles.has(i.option_code)) standardArticles.set(i.option_code, i);
    });
  }

  // Таблицу виброгасителей показываем, только если они вошли в спецификацию.
  const VIBRATION_CODES = ['vibration_suction', 'vibration_discharge'];
  const vibrationInBom = !!result && result.bom.some(i => VIBRATION_CODES.includes(i.option_code));

  const COMPRESSOR_TYPES = [
    { value: 'any', label: 'Любой' },
    { value: 'scroll', label: 'Спиральный' },
    { value: 'screw', label: 'Винтовой' },
    { value: 'recip', label: 'Поршневой' }
  ];
  const typeLabel = (t) => (COMPRESSOR_TYPES.find(x => x.value === t) || {}).label || t;

  // Порядок линий в таблице трубопроводов: нагнетание сверху, под ним
  // жидкость, снизу всасывание.
  const PIPE_LINES = [
    { key: 'discharge', label: 'Нагнетание' },
    { key: 'liquid', label: 'Жидкость' },
    { key: 'suction', label: 'Всасывание' }
  ];

  // Выбранный вариант автоподбора: после расчёта приходит объектом в
  // result.selectedVariant, при повторном выводе формы — полем «id:кол-во».
  const variantKey = (id, qty) => (id ? `${id}:${qty || 1}` : '');
  const selVariant = (() => {
    const v = f.variant;
    if (v && typeof v === 'object' && v.compressorId) return variantKey(v.compressorId, v.qty);
    if (typeof v === 'string' && v) return v;
    return '';
  })();
  const activeVariant = result && result.selectedVariant
    ? variantKey(result.selectedVariant.compressorId, result.selectedVariant.qty)
    : selVariant;
%>

<div class="page-head page-head--inline">
  <div class="page-head__main">
    <h1>Холодильный агрегат</h1>
  </div>
  <div class="page-head__aside">
    <span class="kicker">Подбор оборудования</span>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert--error u-mb-6" role="alert">
    <span class="alert__icon"><%- include('partials/icon', { name: 'alert' }) %></span>
    <div class="alert__body"><%= error %></div>
  </div>
<% } %>

<form method="POST" action="/calc" id="calcForm" class="stack calc-form">

  <!-- ======================= 01. Режим работы ======================= -->
  <section class="panel">
    <div class="panel__head">
      <span class="panel__num">01</span>
      <div class="panel__titles">
        <h2 class="panel__title">Режим работы</h2>
        <p class="panel__sub">Хладагент, температуры и мощность</p>
      </div>
    </div>

    <div class="panel__body">
      <div class="field-grid">
        <div class="field">
          <label class="field__label" for="refrigerantSelect">Хладагент <span class="field__req">*</span></label>
          <select name="refrigerant" id="refrigerantSelect" required>
            <% refrigerants.forEach(r => { %>
              <option value="<%= r.code %>" <%= f.refrigerant === r.code ? 'selected' : '' %>><%= r.code %></option>
            <% }) %>
          </select>
        </div>

        <div class="field">
          <label class="field__label" for="requiredKw">Мощность, кВт <span class="field__req">*</span></label>
          <input type="number" id="requiredKw" name="requiredKw" step="0.1" min="0.1" required
                 value="<%= f.requiredKw || '' %>" placeholder="например 45">
        </div>

        <div class="field">
          <label class="field__label" for="tEvap">t кипения, °C <span class="field__req">*</span></label>
          <input type="number" id="tEvap" name="tEvap" step="1" required
                 value="<%= f.tEvap != null ? f.tEvap : -10 %>">
        </div>

        <div class="field">
          <label class="field__label" for="tCond">t конденсации, °C <span class="field__req">*</span></label>
          <input type="number" id="tCond" name="tCond" step="1" required
                 value="<%= f.tCond != null ? f.tCond : 45 %>">
        </div>

        <div class="field">
          <label class="field__label" for="dTsh">Перегрев, К</label>
          <input type="number" id="dTsh" name="dTsh" step="1"
                 value="<%= f.dTsh != null ? f.dTsh : 10 %>">
        </div>

        <div class="field">
          <label class="field__label" for="dTsc">Переохлаждение, К</label>
          <input type="number" id="dTsc" name="dTsc" step="1"
                 value="<%= f.dTsc != null ? f.dTsc : 0 %>">
        </div>

        <div class="field field--wide">
          <label class="field__label" for="housingCode">Корпус</label>
          <select name="housingCode" id="housingCode">
            <option value="">— не выбран —</option>
            <% housings.forEach(h => { %>
              <option value="<%= h.code %>" <%= f.housingCode === h.code ? 'selected' : '' %>>
                <%= h.name %><% if (isAdmin) { %> — <%= h.price_eur %> EUR<% } %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>
    </div>
  </section>
<!-- ======================= 02. Компрессоры ======================= -->
  <section class="panel">
    <div class="panel__head">
      <span class="panel__num">02</span>
      <div class="panel__titles">
        <h2 class="panel__title">Компрессоры</h2>
        <p class="panel__sub">Автоподбор по мощности или ручной выбор модели</p>
      </div>
    </div>

    <div class="panel__body">
      <div class="choice-set" role="radiogroup" aria-label="Способ подбора компрессоров">
        <label class="choice">
          <input type="radio" name="mode" value="auto" onchange="toggleMode()"
                 <%= selMode === 'auto' ? 'checked' : '' %>>
          Автоподбор по мощности
        </label>
        <label class="choice">
          <input type="radio" name="mode" value="manual" onchange="toggleMode()"
                 <%= selMode === 'manual' ? 'checked' : '' %>>
          Ручной выбор модели
        </label>
      </div>

      <div id="autoBlock" class="mode-block">
        <div class="field-grid field-grid--3">
          <div class="field">
            <label class="field__label" for="autoType">Тип компрессора</label>
            <select name="autoType" id="autoType">
              <% COMPRESSOR_TYPES.forEach(t => { %>
                <option value="<%= t.value %>" <%= selAutoType === t.value ? 'selected' : '' %>><%= t.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label class="field__label" for="autoManufacturer">Производитель</label>
            <select name="autoManufacturer" id="autoManufacturer">
              <option value="any" <%= selAutoMfr === 'any' ? 'selected' : '' %>>Любой</option>
              <% manufacturers.forEach(m => { %>
                <option value="<%= m.id %>" <%= selAutoMfr === String(m.id) ? 'selected' : '' %>><%= m.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label class="field__label" for="autoMaxQty">Макс. компрессоров</label>
            <select name="autoMaxQty" id="autoMaxQty">
              <% [1, 2, 3, 4].forEach(n => { %>
                <option value="<%= n %>" <%= selAutoMaxQty === String(n) ? 'selected' : '' %>><%= n %></option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label class="field__label" for="tolerancePct">Допуск, %</label>
            <input type="number" id="tolerancePct" name="tolerancePct" step="1" min="0" max="100"
                   value="<%= f.tolerancePct != null ? f.tolerancePct : 10 %>">
            <p class="field__hint">± от требуемой мощности</p>
          </div>
        </div>
      </div>

      <div id="manualBlock" class="mode-block is-hidden">
        <div class="field-grid">
          <div class="field">
            <label class="field__label" for="manualType">Тип компрессора</label>
            <select name="manualType" id="manualType">
              <% COMPRESSOR_TYPES.forEach(t => { %>
                <option value="<%= t.value %>" <%= selManualType === t.value ? 'selected' : '' %>><%= t.label %></option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label class="field__label" for="manualManufacturer">Производитель</label>
            <select name="manualManufacturer" id="manualManufacturer">
              <option value="any" <%= selManualMfr === 'any' ? 'selected' : '' %>>Любой</option>
              <% manufacturers.forEach(m => { %>
                <option value="<%= m.id %>" <%= selManualMfr === String(m.id) ? 'selected' : '' %>><%= m.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="field">
            <label class="field__label" for="compressorSelect">Модель</label>
            <select name="compressorId" id="compressorSelect">
              <option value="">— выберите параметры —</option>
            </select>
          </div>

          <div class="field">
            <label class="field__label" for="compressorQty">Количество</label>
            <input type="number" id="compressorQty" name="compressorQty"
                   value="<%= selCompQty %>" min="1" max="6">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= 03. Опции ======================= -->
  <section class="panel">
    <div class="panel__head">
      <span class="panel__num">03</span>
      <div class="panel__titles">
        <h2 class="panel__title">Опции</h2>
        <p class="panel__sub">Отметьте позиции, которые нужны в агрегате</p>
      </div>
    </div>

    <div class="panel__body">
      <div class="options-grid">
        <% selectableOptions.forEach(o => { %>
          <label class="option-item" data-option
                 data-allowed-types="<%= o.allowed_types || '' %>"
                 data-inverter-only="<%= o.inverter_only ? '1' : '0' %>">
            <input type="checkbox" name="options" value="<%= o.code %>"
                   <%= selOpts.includes(o.code) ? 'checked' : '' %>>
            <span class="option-item__text"><%= o.name %></span>
          </label>
        <% }) %>
      </div>
      <p class="hint">
        Доступность опций зависит от типа компрессора: отжим клапанов — только для поршневых,
        инвертор — для поршневых и винтовых, а у спиральных только для моделей, рассчитанных
        на работу с инвертором. Неподходящие опции скрываются автоматически.
      </p>
    </div>
  </section>

  <!-- ============ 04. Стандартная комплектация ============ -->
  <section class="panel">
    <div class="panel__head">
      <span class="panel__num">04</span>
      <div class="panel__titles">
        <h2 class="panel__title">Стандартная комплектация</h2>
        <p class="panel__sub">Входит в агрегат всегда</p>
      </div>
    </div>

    <div class="panel__body">
      <ul class="std-list">
        <% standardOptions.forEach(o => {
             const standardItem = standardArticles.get(o.code); %>
          <li class="std-list__item">
            <span class="std-list__name"><%= o.name %></span>
            <% if (standardItem) { %>
              <span class="std-list__article"><%= standardItem.article %></span>
              <span class="std-list__qty"><%= standardItem.qty %> шт</span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  </section>

  <input type="hidden" name="variantPinned" value="<%= selVariant %>">

  <div class="action-bar">
    <button type="submit" class="btn btn--primary btn--lg">
      <%- include('partials/icon', { name: 'calculator' }) %>Рассчитать
    </button>
    <span class="action-bar__note">Расчёт выполняется по полиномам AHRI/EN12900 из каталога.</span>
  </div>
</form>
<% if (result) { %>
  <!-- ============================ РЕЗУЛЬТАТ ============================ -->
  <div class="section-head">
    <div>
      <span class="kicker">Результат</span>
      <h2>Расчёт холодильного агрегата</h2>
    </div>
    <span class="admin-note">
      Хладагент <strong><%= result.input.refrigerant %></strong>
      · режим <strong><%= result.input.tEvap %> / <%= result.input.tCond %> °C</strong>
    </span>
  </div>

  <% if (result.warnings && result.warnings.length) { %>
    <div class="alert alert--warn u-mb-6" role="status">
      <span class="alert__icon"><%- include('partials/icon', { name: 'alert' }) %></span>
      <div class="alert__body">
        <p class="alert__title">Замечания к расчёту</p>
        <ul>
          <% result.warnings.forEach(w => { %><li><%= w %></li><% }) %>
        </ul>
      </div>
    </div>
  <% } %>

  <% if (result.variantPreviews && result.variantPreviews.length) { %>
    <section class="panel panel--flush u-mb-6">
      <div class="list-head">
        <span class="list-head__title">Варианты автоподбора — от дешёвого к дорогому</span>
        <span class="list-head__meta">
          Цена — за базовый состав. Нажмите на агрегат, чтобы собрать остальной подбор и итоговую цену.
        </span>
      </div>
      <div class="variant-grid">
        <% result.variantPreviews.forEach((v, i) => {
             const value = variantKey(v.compressorId, v.qty);
             const isActive = value === activeVariant; %>
          <button type="submit" form="calcForm"
                  class="variant-card<%= isActive ? ' variant-card--active' : '' %>"
                  name="variant" value="<%= value %>"
                  aria-pressed="<%= isActive ? 'true' : 'false' %>">
            <span class="variant-card__rank">Вариант <%= i + 1 %></span>
            <span class="variant-card__model">
              <%= v.manufacturer %> <%= v.model %><% if (v.qty > 1) { %> × <%= v.qty %><% } %>
            </span>
            <span class="variant-card__spec">
              <b class="num"><%= v.totalKw %></b> кВт ·
              <b class="num"><%= v.oversizePct > 0 ? '+' : '' %><%= v.oversizePct %>%</b> к требуемой
            </span>
            <span class="variant-card__price">
              <% if (v.baseTotalEur != null) { %><b class="num"><%= v.baseTotalEur %></b> EUR<% } else { %>—<% } %>
              <span class="variant-card__note">базовый состав</span>
            </span>
            <% if (isActive) { %><span class="variant-card__flag">выбран</span><% } %>
          </button>
        <% }) %>
      </div>
    </section>
  <% } %>

  <div class="kpi-grid">
    <div class="stat">
      <div class="stat__label">Холодопроизводительность</div>
      <div class="stat__value"><%= result.selection.totals.q_kw %><span class="stat__unit">кВт</span></div>
    </div>
    <div class="stat">
      <div class="stat__label">Потребляемая мощность</div>
      <div class="stat__value"><%= result.selection.totals.power_kw %><span class="stat__unit">кВт</span></div>
    </div>
    <div class="stat">
      <div class="stat__label">COP</div>
      <div class="stat__value"><%= result.selection.totals.cop %></div>
    </div>
    <div class="stat">
      <div class="stat__label">Массовый расход</div>
      <div class="stat__value"><%= result.selection.totals.mass_flow_kgh %><span class="stat__unit">кг/ч</span></div>
    </div>
  </div>

  <div class="grid-2 u-mt-6">
    <section class="card">
      <h3 class="card__title">Характеристики агрегата</h3>
      <table class="kv">
        <tbody>
          <tr><td>Хладагент</td><td><%= result.input.refrigerant %></td></tr>
          <tr><td>t кипения / t конденсации</td><td><%= result.input.tEvap %> / <%= result.input.tCond %> °C</td></tr>
          <tr><td>Перегрев / переохлаждение</td><td><%= result.input.dTsh %> / <%= result.input.dTsc %> К</td></tr>
          <tr><td>Холодопроизводительность</td><td><%= result.selection.totals.q_kw %> кВт</td></tr>
          <tr><td>Потребляемая мощность</td><td><%= result.selection.totals.power_kw %> кВт</td></tr>
          <tr><td>Теплопроизводительность</td><td><%= result.selection.totals.heat_kw %> кВт</td></tr>
          <tr><td>COP</td><td><%= result.selection.totals.cop %></td></tr>
          <tr><td>Массовый расход</td><td><%= result.selection.totals.mass_flow_kgh %> кг/ч</td></tr>
          <tr><td>Суммарный ток</td><td><%= result.selection.totals.current_a %> А</td></tr>
        </tbody>
      </table>
    </section>

    <section class="card">
      <h3 class="card__title">Свойства хладагента — точки цикла</h3>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Точка</th>
              <th class="num">t, °C</th>
              <th class="num">P, бар</th>
              <th class="num">ρ, кг/м³</th>
              <th class="num">h, кДж/кг</th>
            </tr>
          </thead>
          <tbody>
            <% ['suction', 'discharge', 'liquid', 'throttle'].forEach(k => { const p = result.cycle[k]; %>
              <tr>
                <td><%= p.label %></td>
                <td class="num"><%= p.t %></td>
                <td class="num"><%= p.p %></td>
                <td class="num"><%= p.rho %></td>
                <td class="num"><%= p.h %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <section class="panel panel--flush u-mt-6">
    <div class="list-head">
      <span class="list-head__title">Компрессоры</span>
      <span class="list-head__meta">
        Позиций: <b class="num"><%= result.selection.items.length %></b>
        <% if (result.deviationPct != null) { %>
          · отклонение от требуемой мощности
          <b class="num"><%= result.deviationPct > 0 ? '+' : '' %><%= result.deviationPct %>%</b>
          при допуске ±<b class="num"><%= result.input.tolerancePct %>%</b>
        <% } %>
      </span>
    </div>
    <div class="table-wrap table-wrap--plain">
      <table class="data-table">
        <thead>
          <tr>
            <th>Производитель</th>
            <th>Модель</th>
            <th>Тип</th>
            <th class="num">Кол-во</th>
            <th class="num">Q, кВт</th>
            <th class="num">N, кВт</th>
            <th class="num">I, А</th>
            <th class="num">ṁ, кг/ч</th>
          </tr>
        </thead>
        <tbody>
          <% result.selection.items.forEach(c => { %>
            <tr>
              <td><%= c.manufacturer %></td>
              <td class="cell-code"><%= c.model %></td>
              <td class="muted"><%= typeLabel(c.type) %></td>
              <td class="num"><%= c.qty %></td>
              <td class="num"><%= c.q_kw %></td>
              <td class="num"><%= c.power_kw %></td>
              <td class="num"><%= c.current_a %></td>
              <td class="num"><%= c.mass_flow_kgh %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel u-mt-6">
    <div class="panel__head">
      <div class="panel__titles">
        <h3 class="panel__title">Трубопроводы — магистральные линии</h3>
        <p class="panel__sub">Подбор дюймовых диаметров по рекомендованным скоростям</p>
      </div>
    </div>
    <div class="table-wrap table-inset">
      <table class="data-table">
        <thead>
          <tr>
            <th>Линия</th>
            <th class="num">Расход, кг/ч</th>
            <th class="num">V̇, м³/ч</th>
            <th class="num">Ø, "</th>
            <th>Труба, мм</th>
            <th class="num">Скорость, м/с</th>
            <th>Проверка</th>
          </tr>
        </thead>
        <tbody>
          <% PIPE_LINES.forEach(line => {
               const p = result.piping.common[line.key];
               const r = p.recommended; %>
            <tr>
              <td><%= line.label %></td>
              <td class="num"><%= p.massFlowKgh %></td>
              <td class="num"><%= p.vdot_m3h %></td>
              <td class="num num--strong"><%= inch(r.size_in) %></td>
              <td class="num">Ø<%= r.od_mm %>×<%= r.wall_mm %></td>
              <td class="num"><%= r.v %></td>
              <td>
                <% if (r.status === 'ok') { %>
                  <span class="badge badge--ok">в норме</span>
                <% } else { %>
                  <span class="badge badge--warn">вне диапазона</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (result.piping.individual && result.piping.individual.length) { %>
      <div class="panel__body panel__body--continuation">
        <details class="disclosure">
          <summary>Индивидуальные линии компрессоров</summary>
          <div class="disclosure__body">
            <div class="lines-list">
              <% result.piping.individual.forEach(ind => { %>
                <div class="line-item">
                  <span class="line-item__title"><%= ind.label %></span>
                  <span class="line-item__meta">
                    нагнетание <%= inch(ind.discharge.recommended.size_in) %> (<%= ind.discharge.recommended.v %> м/с)
                    · всасывание <%= inch(ind.suction.recommended.size_in) %> (<%= ind.suction.recommended.v %> м/с)
                  </span>
                  <span class="line-item__value">
                    <%= inch(ind.discharge.recommended.size_in) %> / <%= inch(ind.suction.recommended.size_in) %>
                  </span>
                </div>
              <% }) %>
            </div>
          </div>
        </details>
      </div>
    <% } %>
  </section>

  <% if (result.vibration && vibrationInBom) { %>
    <section class="panel panel--flush u-mt-6">
      <div class="list-head">
        <span class="list-head__title">Виброгасители — индивидуально на каждый компрессор</span>
      </div>
      <%- include('partials/vibration-table', { vibration: result.vibration, isAdmin }) %>
    </section>
  <% } %>

  <section class="panel panel--flush u-mt-6">
    <div class="list-head">
      <span class="list-head__title">Спецификация оборудования</span>
      <span class="list-head__meta">Позиций: <b class="num"><%= result.bom.length %></b></span>
    </div>
    <div class="table-wrap table-wrap--plain">
      <table class="data-table">
        <thead>
          <tr>
            <th class="num">№</th>
            <th>Артикул</th>
            <th>Наименование</th>
            <th class="num">Кол-во</th>
            <% if (isAdmin) { %>
              <th class="num">Цена, EUR</th>
              <th class="num">Сумма, EUR</th>
            <% } %>
            <th>Раздел</th>
          </tr>
        </thead>
        <tbody>
          <% result.bom.forEach((it, i) => { %>
            <tr>
              <td class="num"><%= i + 1 %></td>
              <td class="cell-code"><%= it.article %></td>
              <td class="cell-name"><%= it.name %></td>
              <td class="num"><%= it.qty %></td>
              <% if (isAdmin) { %>
                <td class="num"><%= it.unit_price_eur %></td>
                <td class="num"><%= it.total_price_eur %></td>
              <% } %>
              <td class="muted"><%= it.section %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel u-mt-6">
    <div class="panel__head">
      <div class="panel__titles">
        <h3 class="panel__title">Стоимость агрегата</h3>
        <p class="panel__sub">Все цены в EUR без НДС</p>
      </div>
    </div>
    <div class="panel__body">
      <table class="kv totals-narrow">
        <tbody>
          <% if (isAdmin) { %>
            <tr><td>Материалы</td><td><%= result.totals.materials_eur %> EUR</td></tr>
            <tr><td>Мелочь (<%= result.totals.petty_pct %>%)</td><td><%= result.totals.petty_eur %> EUR</td></tr>
            <tr><td>Работы (<%= result.totals.labor_pct %>%)</td><td><%= result.totals.labor_eur %> EUR</td></tr>
            <tr><td>Профит (<%= result.totals.profit_pct %>%)</td><td><%= result.totals.profit_eur %> EUR</td></tr>
            <tr class="total-row"><td>Итого без НДС</td><td><%= result.totals.subtotal_eur %> EUR</td></tr>
            <% if (result.totals.discount_percent > 0) { %>
              <tr><td>Скидка <%= result.totals.discount_percent %>%</td><td>−<%= result.totals.discount_amount_eur %> EUR</td></tr>
            <% } %>
          <% } %>
          <tr class="grand-row"><td>Цена агрегата (без НДС)</td><td><%= result.totals.total_eur %> EUR</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <form method="POST" action="/quotes/save" id="saveForm">
    <% Object.entries({
      refrigerant: result.input.refrigerant, tEvap: result.input.tEvap, tCond: result.input.tCond,
      dTsh: result.input.dTsh, dTsc: result.input.dTsc, requiredKw: result.input.requiredKw,
      tolerancePct: result.input.tolerancePct,
      housingCode: result.input.housingCode || '', mode: result.input.mode,
      autoType: result.input.auto.type, autoManufacturer: result.input.auto.manufacturerId,
      autoMaxQty: result.input.auto.maxQty,
      manualType: result.input.manual.type || 'any', manualManufacturer: result.input.manual.manufacturerId || 'any',
      compressorId: result.input.manual.compressorId || '', compressorQty: result.input.manual.qty,
      variant: selVariant
    }).forEach(([k, v]) => { %>
      <input type="hidden" name="<%= k %>" value="<%= v %>">
    <% }) %>
    <% result.input.selectedOptions.forEach(o => { %>
      <input type="hidden" name="options" value="<%= o %>">
    <% }) %>

    <div class="action-bar">
      <button type="submit" class="btn btn--success btn--lg">
        <%- include('partials/icon', { name: 'save' }) %>Сохранить как КП
      </button>
      <span class="action-bar__note">
        Черновик коммерческого предложения появится в разделе «Мои КП».
      </span>
    </div>
  </form>
<% } %>

<script>
// Дополнительные поля опции: к каким типам компрессоров она применима
// (data-allowed-types) и требуется ли инверторная модель (data-inverter-only).
// Пользователю показываются только применимые опции: отжим клапанов — для
// поршневых, инвертор — для поршневых и винтовых, а у спиральных только для
// моделей, рассчитанных на работу с инвертором; сервер проверяет то же правило.
function currentTypeValue() {
  const mode = document.querySelector('input[name="mode"]:checked').value;
  const select = document.getElementById(mode === 'manual' ? 'manualType' : 'autoType');
  return select ? select.value : 'any';
}

function currentMode() {
  return document.querySelector('input[name="mode"]:checked').value;
}

// Для ручного выбора известна конкретная модель: у спиральных важно, есть ли
// у неё поддержка инвертора. null — модель ещё не выбрана.
function manualModelSupportsInverter() {
  const sel = document.getElementById('compressorSelect');
  const opt = sel && sel.options[sel.selectedIndex];
  if (!opt || !opt.value) return null;
  if (opt.dataset.type !== 'scroll') return true;
  return opt.dataset.inverterCapable === '1';
}

function syncOptionAvailability() {
  const type = currentTypeValue();
  const inverterSupported = currentMode() === 'manual' ? manualModelSupportsInverter() : null;

  document.querySelectorAll('[data-option]').forEach(item => {
    const allowed = (item.dataset.allowedTypes || '').split(',').filter(Boolean);
    const inverterOnly = item.dataset.inverterOnly === '1';

    let visible = true;
    if (allowed.length && type !== 'any' && !allowed.includes(type)) visible = false;
    if (visible && inverterOnly && type === 'scroll' && inverterSupported === false) visible = false;

    item.classList.toggle('is-hidden', !visible);
    if (!visible) {
      const input = item.querySelector('input[type="checkbox"]');
      if (input) input.checked = false;
    }
  });
}

function toggleMode() {
  const mode = currentMode();
  document.getElementById('autoBlock').classList.toggle('is-hidden', mode !== 'auto');
  document.getElementById('manualBlock').classList.toggle('is-hidden', mode !== 'manual');
  if (mode === 'manual') loadCompressors();
  syncOptionAvailability();
}

function loadCompressors(preserveId) {
  const ref = document.getElementById('refrigerantSelect').value;
  const type = document.getElementById('manualType').value;
  const mfr = document.getElementById('manualManufacturer').value;
  const params = new URLSearchParams({ refrigerant: ref, type: type, manufacturer: mfr });

  fetch('/calc/api/compressors?' + params.toString())
    .then(r => r.json())
    .then(d => {
      const sel = document.getElementById('compressorSelect');
      sel.innerHTML = '';
      if (!d.compressors.length) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = '— нет моделей по фильтру —';
        sel.appendChild(opt);
      } else {
        d.compressors.forEach(c => {
          const opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = c.manufacturer + ' ' + c.model;
          opt.dataset.type = c.type;
          opt.dataset.inverterCapable = c.inverter_capable ? '1' : '0';
          if (preserveId && String(c.id) === String(preserveId)) opt.selected = true;
          sel.appendChild(opt);
        });
      }
      syncOptionAvailability();
    })
    .catch(() => {
      const sel = document.getElementById('compressorSelect');
      sel.innerHTML = '';
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = '— не удалось загрузить список моделей —';
      sel.appendChild(opt);
      syncOptionAvailability();
    });
}

['refrigerantSelect', 'manualType', 'manualManufacturer'].forEach(id => {
  document.getElementById(id).addEventListener('change', () => {
    if (currentMode() === 'manual') loadCompressors();
    syncOptionAvailability();
  });
});

['autoType', 'compressorSelect'].forEach(id => {
  document.getElementById(id).addEventListener('change', syncOptionAvailability);
});

document.addEventListener('DOMContentLoaded', () => {
  toggleMode();
  if (currentMode() === 'manual') {
    loadCompressors('<%= manual.compressorId || "" %>');
  }
});
</script>

<%- include('partials/footer') %>
