<%- include('partials/header', { title: 'КП ' + q.number }) %>

<%
  const isAdmin = user.role === 'admin';
  const t = result.totals;
  const STATUS_LABELS = {
    draft: 'Черновик',
    sent: 'На утверждении',
    approved: 'Утверждено',
    rejected: 'Отклонено'
  };
  const statusLabel = STATUS_LABELS[q.status] || q.status;
  const quoteUrl = '/quotes/' + encodeURIComponent(q.number);
%>

<div class="page-head">
  <div class="page-head__main">
    <span class="kicker">Коммерческое предложение</span>
    <h1><%= q.number %></h1>

    <dl class="meta-row">
      <div class="meta-row__item">
        <dt>Клиент</dt>
        <dd><%= q.user_name %><%= q.company ? ' · ' + q.company : '' %></dd>
      </div>
      <div class="meta-row__item">
        <dt>Дата</dt>
        <dd class="num"><%= q.created_at %></dd>
      </div>
      <div class="meta-row__item">
        <dt>Статус</dt>
        <dd><span class="status status-<%= q.status %>"><%= statusLabel %></span></dd>
      </div>
    </dl>
  </div>

  <div class="page-head__aside no-print">
    <a href="<%= quoteUrl %>/print" class="btn btn--secondary" target="_blank" rel="noopener">
      <%- include('partials/icon', { name: 'print' }) %>Печатная форма
    </a>
    <% if (q.status === 'approved') { %>
      <a href="<%= quoteUrl %>/production" class="btn btn--primary">
        <%- include('partials/icon', { name: 'factory' }) %>Производственная спецификация
      </a>
    <% } %>
  </div>
</div>

<div class="grid-2">
  <section class="card">
    <h2 class="card__title">Технические характеристики</h2>
    <table class="kv">
      <tbody>
        <tr><td>Хладагент</td><td><%= result.input.refrigerant %></td></tr>
        <tr><td>t кипения / t конденсации</td><td><%= result.input.tEvap %> / <%= result.input.tCond %> °C</td></tr>
        <tr><td>Холодопроизводительность</td><td><%= result.selection.totals.q_kw %> кВт</td></tr>
        <tr><td>Потребляемая мощность</td><td><%= result.selection.totals.power_kw %> кВт</td></tr>
        <tr><td>COP</td><td><%= result.selection.totals.cop %></td></tr>
        <tr><td>Массовый расход</td><td><%= result.selection.totals.mass_flow_kgh %> кг/ч</td></tr>
        <tr>
          <td>Трубопроводы (всас / нагн / жидк)</td>
          <td><%= result.piping.common.suction.recommended.size_in %> / <%= result.piping.common.discharge.recommended.size_in %> / <%= result.piping.common.liquid.recommended.size_in %>"</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="card">
    <h2 class="card__title">Стоимость</h2>
    <table class="kv">
      <tbody>
        <% if (isAdmin) { %>
          <tr><td>Материалы</td><td><%= t.materials_eur %> EUR</td></tr>
          <tr><td>Мелочь (<%= t.petty_pct %>%)</td><td><%= t.petty_eur %> EUR</td></tr>
          <tr><td>Работы (<%= t.labor_pct %>%)</td><td><%= t.labor_eur %> EUR</td></tr>
          <tr><td>Профит (<%= t.profit_pct %>%)</td><td><%= t.profit_eur %> EUR</td></tr>
          <tr class="total-row"><td>Итого без НДС</td><td><%= t.subtotal_eur %> EUR</td></tr>
          <tr><td>Скидка <%= t.discount_percent %>%</td><td>−<%= t.discount_amount_eur %> EUR</td></tr>
        <% } %>
        <tr class="grand-row"><td>Цена агрегата (без НДС)</td><td><%= t.total_eur %> EUR</td></tr>
      </tbody>
    </table>
    <% if (!isAdmin) { %>
      <p class="card__note">Итоговая стоимость с учётом индивидуальной скидки. НДС не включён.</p>
    <% } %>
  </section>
</div>

<section class="panel panel--flush">
  <div class="list-head">
    <span class="list-head__title">Спецификация оборудования</span>
    <span class="list-head__meta">Позиций: <b class="num"><%= result.bom.length %></b></span>
  </div>
  <div class="table-wrap table-wrap--plain">
    <table class="data-table">
      <thead>
        <tr>
          <th class="num">№</th>
          <th>Артикул</th>
          <th>Наименование</th>
          <th class="num">Кол-во</th>
          <% if (isAdmin) { %>
            <th class="num">Цена, EUR</th>
            <th class="num">Сумма, EUR</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% result.bom.forEach((it, i) => { %>
          <tr>
            <td class="num"><%= i + 1 %></td>
            <td class="cell-code"><%= it.article %></td>
            <td class="cell-name"><%= it.name %></td>
            <td class="num"><%= it.qty %></td>
            <% if (isAdmin) { %>
              <td class="num"><%= it.unit_price_eur %></td>
              <td class="num"><%= it.total_price_eur %></td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<div class="action-bar no-print">
  <% if (q.status === 'draft') { %>
    <form method="POST" action="<%= quoteUrl %>/status" class="inline-form">
      <input type="hidden" name="status" value="sent">
      <button type="submit" class="btn btn--primary">
        <%- include('partials/icon', { name: 'send' }) %>Отправить на утверждение
      </button>
    </form>
  <% } %>

  <% if (isAdmin && (q.status === 'sent' || q.status === 'draft')) { %>
    <form method="POST" action="<%= quoteUrl %>/status" class="inline-form">
      <input type="hidden" name="status" value="approved">
      <button type="submit" class="btn btn--success">
        <%- include('partials/icon', { name: 'check' }) %>Утвердить
      </button>
    </form>
    <form method="POST" action="<%= quoteUrl %>/status" class="inline-form">
      <input type="hidden" name="status" value="rejected">
      <button type="submit" class="btn btn--danger-soft">
        <%- include('partials/icon', { name: 'x' }) %>Отклонить
      </button>
    </form>
  <% } %>

  <span class="action-bar__spacer"></span>
  <a href="/quotes" class="btn btn--ghost">
    <%- include('partials/icon', { name: 'arrow-left' }) %>К списку КП
  </a>
</div>

<%- include('partials/footer') %>
