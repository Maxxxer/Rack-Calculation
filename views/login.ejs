<%- include('partials/header', { title: 'Вход' }) %>

<div class="auth-shell">
  <div class="auth-card">
    <div class="auth-card__head">
      <span class="kicker">Доступ к системе</span>
      <h1>Вход</h1>
      <p class="auth-card__note">Используйте почту, указанную при регистрации.</p>
    </div>

    <% if (error) { %>
      <div class="alert alert--error" role="alert">
        <span class="alert__icon"><%- include('partials/icon', { name: 'alert' }) %></span>
        <div class="alert__body"><%= error %></div>
      </div>
    <% } %>

    <form method="POST" action="/login">
      <div class="field">
        <label class="field__label" for="loginEmail">Email <span class="field__req">*</span></label>
        <input type="email" id="loginEmail" name="email" autocomplete="username" required autofocus
               value="<%= typeof email !== 'undefined' && email ? email : '' %>">
      </div>
      <div class="field">
        <label class="field__label" for="loginPassword">Пароль <span class="field__req">*</span></label>
        <input type="password" id="loginPassword" name="password" autocomplete="current-password" required>
      </div>
      <label class="check-row" for="rememberMe">
        <input type="checkbox" id="rememberMe" name="remember"
               <%= typeof remember !== 'undefined' && remember ? 'checked' : '' %>>
        <span>Запомнить меня на 30 дней</span>
      </label>
      <button type="submit" class="btn btn--primary btn--lg btn--block">Войти</button>
    </form>
  </div>

  <p class="auth-foot">
    Нет аккаунта? <a href="/register">Отправить заявку</a> — доступ откроется после подтверждения администратором.
  </p>
</div>

<%- include('partials/footer') %>
