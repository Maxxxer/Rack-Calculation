<%- include('partials/header', { title: 'Производственная спецификация ' + q.number }) %>

<%
  const t = result.totals;
  const quoteUrl = '/quotes/' + encodeURIComponent(q.number);
  // Порядок линий: нагнетание, жидкость, всасывание
  const pipingLines = [
    { label: 'Нагнетание', key: 'discharge' },
    { label: 'Жидкость', key: 'liquid' },
    { label: 'Всасывание', key: 'suction' }
  ];

  // Таблицу виброгасителей показываем, только если они вошли в спецификацию.
  const VIBRATION_CODES = ['vibration_suction', 'vibration_discharge'];
  const vibrationInBom = result.bom.some(i => VIBRATION_CODES.includes(i.option_code));
%>

<div class="page-head">
  <div class="page-head__main">
    <span class="kicker">Производство</span>
    <h1>Спецификация <%= q.number %></h1>
    <dl class="meta-row">
      <div class="meta-row__item">
        <dt>КП утверждено</dt>
        <dd class="num"><%= q.approved_at || '—' %></dd>
      </div>
      <div class="meta-row__item">
        <dt>Назначение</dt>
        <dd>Полная спецификация для производственного отдела</dd>
      </div>
    </dl>
  </div>
  <div class="page-head__aside no-print">
    <a href="<%= quoteUrl %>/production.csv" class="btn btn--secondary">
      <%- include('partials/icon', { name: 'download' }) %>Экспорт CSV
    </a>
    <a href="<%= quoteUrl %>" class="btn btn--ghost">
      <%- include('partials/icon', { name: 'arrow-left' }) %>К КП
    </a>
  </div>
</div>

<div class="grid-2">
  <section class="panel">
    <div class="panel__head">
      <div class="panel__titles">
        <h2 class="panel__title">Режим работы</h2>
      </div>
    </div>
    <div class="panel__body">
      <table class="kv kv--tight">
        <tbody>
          <tr><td>Хладагент</td><td><%= result.input.refrigerant %></td></tr>
          <tr><td>t кип / t конд</td><td><%= result.input.tEvap %> / <%= result.input.tCond %> °C</td></tr>
          <tr><td>Холодопроизводительность</td><td><%= result.selection.totals.q_kw %> кВт</td></tr>
          <tr><td>Массовый расход</td><td><%= result.selection.totals.mass_flow_kgh %> кг/ч</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <div class="panel__head">
      <div class="panel__titles">
        <h2 class="panel__title">Трубопроводы</h2>
      </div>
    </div>
    <div class="panel__body">
      <table class="kv kv--tight">
        <tbody>
          <% pipingLines.forEach(line => {
               const p = result.piping.common[line.key];
               const r = p.recommended; %>
            <tr>
              <td><%= line.label %></td>
              <td><%= inch(r.size_in) %> (Ø<%= r.od_mm %>×<%= r.wall_mm %>)</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<section class="panel panel--flush">
  <div class="list-head">
    <span class="list-head__title">Полная спецификация (BOM)</span>
    <span class="list-head__meta">Позиций: <b class="num"><%= result.bom.length %></b></span>
  </div>
  <div class="table-wrap table-wrap--plain">
    <table class="data-table">
      <thead>
        <tr>
          <th class="num">№</th>
          <th>Артикул</th>
          <th>Наименование</th>
          <th class="num">Кол-во</th>
          <th class="num">Цена, EUR</th>
          <th class="num">Сумма, EUR</th>
          <th>Раздел</th>
        </tr>
      </thead>
      <tbody>
        <% result.bom.forEach((it, i) => { %>
          <tr>
            <td class="num"><%= i + 1 %></td>
            <td class="cell-code"><%= it.article %></td>
            <td class="cell-name"><%= it.name %></td>
            <td class="num"><%= it.qty %></td>
            <td class="num"><%= it.unit_price_eur %></td>
            <td class="num"><%= it.total_price_eur %></td>
            <td class="muted"><%= it.section %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<% if (result.vibration && vibrationInBom) { %>
  <section class="panel panel--flush">
    <div class="list-head">
      <span class="list-head__title">Виброгасители — индивидуально на каждый компрессор</span>
    </div>
    <%- include('partials/vibration-table', { vibration: result.vibration, isAdmin: true }) %>
  </section>
<% } %>

<section class="panel">
  <div class="panel__head">
    <div class="panel__titles">
      <h2 class="panel__title">Калькуляция</h2>
      <p class="panel__sub">Себестоимость, работы и итоговая цена без НДС.</p>
    </div>
  </div>
  <div class="panel__body">
    <table class="kv totals-narrow">
      <tbody>
        <tr><td>Материалы</td><td><%= t.materials_eur %> EUR</td></tr>
        <tr><td>Мелочь (<%= t.petty_pct %>%)</td><td><%= t.petty_eur %> EUR</td></tr>
        <tr><td>Работы (<%= t.labor_pct %>%)</td><td><%= t.labor_eur %> EUR</td></tr>
        <tr><td>Профит (<%= t.profit_pct %>%)</td><td><%= t.profit_eur %> EUR</td></tr>
        <tr class="total-row"><td>Итого без НДС</td><td><%= t.subtotal_eur %> EUR</td></tr>
        <tr><td>Скидка <%= t.discount_percent %>%</td><td>−<%= t.discount_amount_eur %> EUR</td></tr>
        <tr class="grand-row"><td>ВСЕГО</td><td><%= t.total_eur %> EUR</td></tr>
      </tbody>
    </table>
  </div>
</section>

<%- include('partials/footer') %>
